# Example environment variables - copy to `.env` and fill with your real values
# Do NOT commit your `.env` file to source control.

# Database connection (Postgres / Cloud SQL / Supabase)
DATABASE_URL=postgres://user:pass@localhost:5432/veritas
SUPABASE_DATABASE_URL=

# Session & admin security
SESSION_SECRET=change_this_session_secret
ADMIN_PASSWORD=
MFA_ENCRYPTION_KEY=

# Optional Twilio WhatsApp notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Node environment
NODE_ENV=development
PORT=3000

# Frontend & AI Studio URLs
VITE_API_URL=/api
CLIENT_URL=http://localhost:3000
COOKIE_DOMAIN=localhost
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

